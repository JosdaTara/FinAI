# Puerto del servidor
PORT=4000

# Origen permitido (URL del frontend en desarrollo)
CORS_ORIGIN=http://localhost:5173

# Ruta del archivo JSON de la cuenta de servicio de Firebase
# (relativa a la carpeta backend/, ej: ./serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# API key de Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo de Gemini a utilizar
GEMINI_MODEL=gemini-2.0-flash
