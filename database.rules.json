{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "movements": {
      ".read": false,
      ".write": false
    },
    "budgets": {
      ".read": false,
      ".write": false
    }
  }
}
